# Environment Variables for SkillLens
# Replace with your actual Supabase credentials when ready.
# If left empty, SkillLens automatically runs in Local SQLite Demo mode!

FLASK_SECRET_KEY=skilllens-hackathon-secret-key-2026
FLASK_DEBUG=True

# Supabase Credentials (from your Supabase Project Settings -> API)
# 1. Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# 2. Publishable Key (Recommended) or Anon Key
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Google Gemini API Key (optional, for live AI project generation)
GEMINI_API_KEY=
