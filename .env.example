# Environment Variables for SkillLens
# Replace with your actual Supabase and Gemini credentials when ready.
# If left empty, SkillLens automatically runs in Offline / Local Demo mode!

FLASK_SECRET_KEY=skilllens-hackathon-secret-key-2026
FLASK_DEBUG=True

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Gemini API Key (optional, for live AI project & roadmap generation)
GEMINI_API_KEY=
